# QuiLLora AI — Frontend environment
#
# Copy to `.env` and point it at your backend:  cp .env.example .env
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the QuiLLora AI backend, WITHOUT the /api/v1 suffix —
# the API client appends it.
#
#   local:      http://localhost:4000
#   production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:4000
